{
	"name": "pacman-web",
	"description": "A web frontend for the Pac-Man game, including leaderboards and OAuth.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@^1.3.5",
	"engines": {
		"bun": ">=1.3.5"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"preinstall": "npx only-allow bun",
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"@tabler/icons-svelte": "^3.50.0",
		"overlayscrollbars": "^2.17.0",
		"overlayscrollbars-svelte": "^0.5.5"
	},
	"devDependencies": {
		"@fontsource/outfit": "^5.3.0",
		"@fontsource/russo-one": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"fontkit": "^2.0.4",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"subset-font": "^2.9.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	}
}
