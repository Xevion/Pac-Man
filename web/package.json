{
	"name": "pacman-web",
	"description": "A web frontend for the Pac-Man game, including leaderboards and OAuth.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@^1.3.5",
	"engines": {
		"bun": ">=1.3.5"
	},
	"scripts": {
		"preinstall": "npx only-allow bun",
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"@tabler/icons-svelte": "^3.46.0",
		"overlayscrollbars": "^2.16.0",
		"overlayscrollbars-svelte": "^0.5.5"
	},
	"devDependencies": {
		"@fontsource/outfit": "^5.3.0",
		"@fontsource/russo-one": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^26.2.0",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fontkit": "^2.0.4",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"subset-font": "^2.5.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	}
}
